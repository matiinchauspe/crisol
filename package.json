{
  "name": "crisol",
  "type": "module",
  "private": true,
  "version": "0.2.1",
  "bin": {
    "crisol": "./dist/crisol"
  },
  "scripts": {
    "typecheck": "bun check",
    "test": "bun test",
    "build": "bun build ./src/cli.ts --compile --outfile dist/crisol",
    "build:darwin-arm64": "bun build ./src/cli.ts --compile --target=bun-darwin-arm64 --outfile dist/crisol-darwin-arm64",
    "build:darwin-x64": "bun build ./src/cli.ts --compile --target=bun-darwin-x64 --outfile dist/crisol-darwin-x64",
    "build:release": "bun run build:darwin-arm64 && bun run build:darwin-x64"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
